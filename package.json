{
  "name": "ethos-film",
  "private": true,
  "type": "module",
  "scripts": {
    "compose": "node picture/bundle.mjs",
    "test": "node --test tests/picture/",
    "test:coverage": "c8 --include=picture/film.js --include=picture/film/** npm test",
    "format:markdown": "prettier --no-config --no-editorconfig --ignore-path .gitignore --print-width 100 --prose-wrap preserve --no-error-on-unmatched-pattern --write AGENTS.md CHANGELOG.md README.md 'openspec/changes/*/*.md' 'openspec/changes/*/specs/**/*.md'",
    "format:markdown:check": "prettier --no-config --no-editorconfig --ignore-path .gitignore --print-width 100 --prose-wrap preserve --no-error-on-unmatched-pattern --check AGENTS.md CHANGELOG.md README.md 'openspec/changes/*/*.md' 'openspec/changes/*/specs/**/*.md'"
  },
  "devDependencies": {
    "@puppeteer/browsers": "3.2.3",
    "esbuild": "0.25.12",
    "gsap": "3.15.0",
    "hyperframes": "0.8.150",
    "prettier": "3.9.10",
    "puppeteer-core": "25.12.0"
  }
}
