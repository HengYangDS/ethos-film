  "retakes": {
    "08": {
      "groups": {
        "1": {
          "seed": 131389,
          "text_sha256": "9f4584f08dff5a8b339635230c983eab1dd070f3934d87d44fbac06413737033"
        },
        "2": {
          "seed": 91794,
          "text_sha256": "fd96d9be0f6ac1fcfc609f9cba91c4dbaad46d7a7609726be42f73feaf44757e",
          "run_on": {
            "spoken_text": "采纳的意图来自正式变更，内核把其中的验收条件编译成一个临时的值，叫 Commitment。刚观察到的事实叫 Facts，编译出来的计划叫 Transition Plan。",
            "cut_sample": 240720
          }
        },
        "5": {
          "seed": 107632,
          "text_sha256": "bf9543fa6dd355bd0e8014da9577a163517f1d7df8697609f43288c060dda806",
          "run_on": {
            "spoken_text": "计划不会自己生效。Git 用一个个名字指向各个版本，这些名字叫引用。",
            "cut_sample": 284880
          }
        }
      }
    },
    "09": {
      "groups": {
        "1": {
          "seed": 139309,
          "text_sha256": "1c444f1ef847c0b7dd468efe6bdb720f85ff2c48f42b5c34ec0c6edd559438ab"
        },
        "6": {
          "seed": 99714,
          "text_sha256": "8977e5f9b91a8c329d1a077da7f86779c3527201f60f7cb7a746e36c22199494",
          "run_on": {
            "spoken_text": "平时用的时候，先运行 Eethos 的状态命令，看清现状和下一步，只做这一步，做完再看一次。",
            "cut_sample": 203760
          }
        }
      }
    },
    "01": {
      "groups": {
        "3": {
          "seed": 139301,
          "text_sha256": "de6ce23d99fda957d839885f31eb22d96ab896d8815becc84c4362da9eb24d0c",
          "run_on": {
            "spoken_text": "Eethos 就是针对这种情况设计的：人和 Agent 在同一个仓库里分工做事。这个名字取自几个英文词的首字母，合起来的意思是，人和 Agent 一起打理一项工作时，信任要建立在证据上。",
            "cut_sample": 240960
          }
        },
        "4": {
          "seed": 147220,
          "text_sha256": "7a16652a31b490241a919d44584f9480bdc8f4a6f92f85e22718cfedaf643270",
          "run_on": {
            "spoken_text": "它不是要多加一层治理。它承诺三件事。一是已经采纳的意图不会丢。二是不确定的地方会明确说出来，好让人能接着处理。三是出了错，也能把结果恢复过来。",
            "cut_sample": 281040
          }
        }
      }
    },
    "02": {
      "groups": {
        "4": {
          "seed": 107626,
          "text_sha256": "1b2635f38e16a5acc6a0fa7498d2cded719bcb17ea2c33b82355d46bc7656090",
          "run_on": {
            "spoken_text": "后面就拿这两个例子来讲。它们只是举例，不是实测的结果。",
            "cut_sample": 270480
          }
        }
      }
    },
    "03": {
      "groups": {
        "1": {
          "seed": 91789,
          "text_sha256": "48679052897dc9a82380e05b66a890d5c8221dd5f24d72874c6d32575ba2fa38",
          "run_on": {
            "spoken_text": "比如要求管线经得起重新运行，光写一句“更可靠”是不够的。还要写明哪些记录算同一条，哪些看着像重复、其实要留下，以及用什么办法检验确实没有重复。",
            "cut_sample": 100560
          }
        },
        "4": {
          "seed": 123465,
          "text_sha256": "769665faaa7416e38e6c47b5d971488024b21131da754a310f1831c3cd2a840c",
          "run_on": {
            "spoken_text": "Eethos 会读取这份正式变更，把它编译成验收条件。在仓库里，采纳了的意图只记在正式变更里，不在别的地方另记一份。",
            "cut_sample": 319440
          }
        },
        "2": {
          "seed": 123465,
          "text_sha256": "3f9fb0b8e8e21c367a2191a7cfc2a6dbc2a84dddeaac48435d959adca75896e0",
          "run_on": {
            "spoken_text": "研究信号，也要先写下假设，再写明出现什么结果就说明它不成立。",
            "cut_sample": 248400
          }
        }
      }
    },
    "05": {
      "groups": {
        "6": {
          "seed": 99710,
          "text_sha256": "f9b68b540d28cffa0263b9bbba5dabcedb085f9df919516debffade603ce74a2",
          "run_on": {
            "spoken_text": "Eethos 自己的代码集中做一件事，就是把采纳了的意图和刚观察到的事实，变成可以检验的仓库改动。",
            "cut_sample": 121680
          }
        },
        "7": {
          "seed": 91791,
          "text_sha256": "4eae88fce4fbb754a2e7e2dc7682743e478de548ad308ea67eef86806c70b33d",
          "run_on": {
            "spoken_text": "一项正式变更，常常有好几个人和 Agent 同时在推进。谁负责哪一块，哪些还只是尝试，工作怎么交接，大家心里都要有数。",
            "cut_sample": 159600
          }
        },
        "2": {
          "seed": 115548,
          "text_sha256": "5c14fdeb851b65940a34a43a2aee7eefd771442f232f592366b33cdd8e20f4e7",
          "run_on": {
            "spoken_text": "Eethos 管这叫：每一项责任，只交给一个地方负责。",
            "cut_sample": 175440
          }
        },
        "5": {
          "seed": 91791,
          "text_sha256": "466939f3398e356b284d356b40dbdeb95f79dc413d811330826ee883fa092e9c",
          "run_on": {
            "spoken_text": "选定了新办法，就把它替下来的旧做法一并撤掉，不让两套东西长期并存。",
            "cut_sample": 153120
          }
        }
      }
    },
    "07": {
      "groups": {
        "5": {
          "seed": 99712,
          "text_sha256": "b4b6701683fb756e7a5962c6b57adc2eeaa07f3d62758b5e62874d80a2529cb8",
          "run_on": {
            "spoken_text": "这套做法靠一个很小的信任内核来支撑。",
            "cut_sample": 206400
          }
        },
        "2": {
          "seed": 139307,
          "text_sha256": "5fd6df7b49adbf2bf0ea06b106209bba5da578883fe5884e502a95af2651ceeb",
          "run_on": {
            "spoken_text": "如果那里有还没提交的改动，或者文件是别人的、归属说不清，又或者状态跟预期对不上，就只能看、不能写，直到重新检查放行。",
            "cut_sample": 206160
          }
        },
        "4": {
          "seed": 139307,
          "text_sha256": "fe25fac8d0988d53e0ab17cb46dfb9f11ae7977b7abf4af95f8b027271a4e5ac",
          "run_on": {
            "spoken_text": "还有一个局限要说清楚。这套机制协调的，是愿意遵守约定的参与者。它不是操作系统那种隔离，拦不住同一个账户下不守约定的程序。",
            "cut_sample": 147360
          }
        }
      }
    },
    "10": {
      "groups": {
        "4": {
          "seed": 107634,
          "text_sha256": "586a877fe1ace0622b5744abbc97d1ff63385231e07beee9f03320ee760cde88",
          "run_on": {
            "spoken_text": "比如本地证明通过了，GitLab 和 GitHub 上的结果还没看，那如实的说法是：本地证明通过，两个平台上的结果还没有检验。",
            "cut_sample": 96720
          }
        },
        "1": {
          "seed": 147229,
          "text_sha256": "0b7e68bdcd9bc46f611d98f4599d8353b470892109f4e1ecc3a3f7f6dcffaeec",
          "run_on": {
            "spoken_text": "Eethos 在本地把仓库声明的检查跑一遍，这叫本地证明。本地证明和 GitLab、GitHub 上的自动检查，是三份来源不同的证据。",
            "cut_sample": 210000
          }
        }
      }
    },
    "11": {
      "groups": {
        "4": {
          "seed": 99716,
          "text_sha256": "ad9b502850c886d5db1a19360943740816ce0618c06aab4423da0e385718c3fc",
          "run_on": {
            "spoken_text": "一项改动还没被接受，就用之前已经信任的规则来判断它。修改规则的提案，不能自己给自己盖章。",
            "cut_sample": 176880
          }
        },
        "2": {
          "seed": 99716,
          "text_sha256": "550a658ad21c86e0bb51cc65c610575471c47aa447b09b342915b6e6754197fb",
          "run_on": {
            "spoken_text": "Eethos 只保护两个分支，一般叫 dev 和 main。dev 存放已经接受的改动，main 用来发布。",
            "cut_sample": 194640
          }
        }
      }
    },
    "14": {
      "groups": {
        "2": {
          "seed": 131395,
          "text_sha256": "2724d4b007e55b8acac6b20cc31c1203bef1f2ebd4dba6265d91ab624d8012c4",
          "run_on": {
            "spoken_text": "改目标、改标准，都要由有权决定的人重新采纳。不能为了让结果通过检查，悄悄把条件放宽。",
            "cut_sample": 137040
          }
        },
        "4": {
          "seed": 115557,
          "text_sha256": "dc9d11c85bb325504a30a0dc732e0ecd00d3072ccec7de9c2ed2828d89ed82cf",
          "run_on": {
            "spoken_text": "一个项目的经验，可以拿来提议改进大家共用的机制；但这个项目的决定权和不公开的业务背景，不会跟着这条建议一起交出去。",
            "cut_sample": 239040
          }
        },
        "5": {
          "seed": 99719,
          "text_sha256": "5ecb3e649e756df7cf8bc4ff46498915d9b383e2890585b56c7799f990e219ee",
          "run_on": {
            "spoken_text": "有时候，新的情况跟现有的模型怎么也对不上。这里说的模型，就是前面讲的概念和结构，不是统计模型。",
            "cut_sample": 196560
          }
        }
      }
    },
    "15": {
      "groups": {
        "1": {
          "seed": 91801,
          "text_sha256": "e55de24c3ee02c0a7161b64e77242edb82d51fdc12ff271e404997cebd67deb8",
          "run_on": {
            "spoken_text": "可能是两份都有效的输入互相矛盾，也可能是用现有的模型去表达，总要丢掉一些信息。",
            "cut_sample": 168000
          }
        },
        "3": {
          "seed": 131396,
          "text_sha256": "3e963cf5039656e6dfb25c015cdd78ea8e591d04e23f0e2f2b86d00c5844b95c",
          "run_on": {
            "spoken_text": "模型提升的做法是这样的：先留住那些互相冲突的情况和证据，找到模型里受影响的最小部分，把它改到能装下这些情况。",
            "cut_sample": 245760
          }
        }
      }
    },
    "16": {
      "groups": {
        "1": {
          "seed": 99721,
          "text_sha256": "a1a6cc0d7bdb5a094f4ec87eeb53fcbb9d84823e1a6b7e7e5cde4da3a92fde73",
          "run_on": {
            "spoken_text": "区别只在配置和适配器。每个仓库在自己的配置里，声明要做哪些检查、用哪些参数、证明做到多深。适配器负责连接原生工具，比如 Git、代码托管平台和持续集成。",
            "cut_sample": 163920
          }
        },
        "2": {
          "seed": 139316,
          "text_sha256": "4738ce7b9b4336cae6c0317c445e876e99a8b8f4d22ab2c6a6067a981f251a12",
          "run_on": {
            "spoken_text": "这不是把 Eethos 复制一份放到别处。每个仓库保留自己的业务模型、目录结构和平台习惯，Eethos 只用同一个以证据为准的循环，来判断每一次改动。",
            "cut_sample": 270480
          }
        },
        "4": {
          "seed": 139316,
          "text_sha256": "59a27958149b39fbc15c0bdde7936ebe0a003c626ad15e7b8a707e32ccd400f1",
          "run_on": {
            "spoken_text": "还没接入的仓库，先预览接入计划，预览什么都不改。确认没有冲突，也清楚出了错怎么恢复，再正式执行，因为执行要是中途被打断，可能只改了一半。",
            "cut_sample": 175440
          }
        }
      }
    },
    "18": {
      "groups": {
        "2": {
          "seed": 139318,
          "text_sha256": "9f3d05645f45db48e6187661e3e7d8f604833814daad7fbd3fc9713029ec7ad5",
          "run_on": {
            "spoken_text": "三是视图只管展示，跟决定权分开，看得到，不等于有权去做。四是一个机制的责任结束了，就让它退场。",
            "cut_sample": 185760
          }
        },
        "4": {
          "seed": 107642,
          "text_sha256": "8bb2f1f50ee7199acc8109c028d3468e6ee3765b5fe80f153dcb04f7212a277a",
          "run_on": {
            "spoken_text": "新的问题出现时，已有的理解和学到的东西，仍然可以作为起点。",
            "cut_sample": 158880
          }
        },
        "5": {
          "seed": 99723,
          "text_sha256": "f8f1b90922d71631b0e4ee74a49d1673771f07b2a30244b602e86c8410fe4d2b",
          "run_on": {
            "spoken_text": "项目可以接着做下去，方法也始终可以修改。",
            "cut_sample": 104400
          }
        }
      }
    },
    "04": {
      "groups": {
        "4": {
          "seed": 139304,
          "text_sha256": "32006cec9c08f0bcdb7dc2fbd8b0be501334a6b86eb2fa89913c51ff36fcd760",
          "run_on": {
            "spoken_text": "同样的输入，总会编译出同样的验收条件，可这保证不了理解本身是对的。",
            "cut_sample": 128400
          }
        }
      }
    },
    "06": {
      "groups": {
        "3": {
          "seed": 139306,
          "text_sha256": "7322486f95b31fbe3e1257b2b00541fe7780fe6bc6bcee8dbe525f5fd260e3bd",
          "run_on": {
            "spoken_text": "几条通道可以合作，把各自的贡献合到一起；也可以竞争，最后选出一个结果，或者一个都不选。",
            "cut_sample": 317760
          }
        },
        "5": {
          "seed": 91792,
          "text_sha256": "433b4ae4ec8bf81de1d9622f6ac3a758f06267717ef93b2b00270f8f7ccc2502",
          "run_on": {
            "spoken_text": "持有一条工作通道，不等于此刻就能改某个文件。",
            "cut_sample": 126240
          }
        }
      }
    },
    "12": {
      "groups": {
        "4": {
          "seed": 115555,
          "text_sha256": "958c02559c852e32868d67f8a23969b79d65d99f5f62a1dc1c9526d1ae14dfe1",
          "run_on": {
            "spoken_text": "还要确认，版本部署到了哪里，使用者实际在用的又是哪个版本。",
            "cut_sample": 108240
          }
        }
      }
    },
    "13": {
      "groups": {
        "6": {
          "seed": 91799,
          "text_sha256": "cab18472adaaf1ec7f3f806611b7c4966497667c300db27e3b735f6b5cfe3525",
          "run_on": {
            "spoken_text": "按设计，Eethos 要把这些观察跟原来的要求和假设对应起来，但不会拿开发上的指标，去代替项目自己衡量业务成败的标准。",
            "cut_sample": 56400
          }
        }
      }
    }
  }
}
