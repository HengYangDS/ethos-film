# Third-party fonts, their licenses and the Creative Commons legal code keep their upstream names.
assets/fonts/** linguist-vendored
LICENSES/** linguist-vendored
# The composition the engine reads is the bundle of the modules under picture/film/: npm run compose
# writes it and the composition test checks it, so the modules hold the authored code.
picture/film.js linguist-generated
# The Python checks verify the film's sources through the installed engine, which this
# repository does not carry, so they are tooling that the film-checks gate runs; the bundler and
# the helpers that find the engine's JavaScript and stand in for the page are tooling for the
# composition tests.
tests/**/*.py ethos-role=tooling
tests/engine.mjs ethos-role=tooling
tests/picture/page.mjs ethos-role=tooling
picture/bundle.mjs ethos-role=tooling
# Normalize every text file to LF in the index and working tree.
* text=auto eol=lf
